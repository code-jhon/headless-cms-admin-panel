# ---------------------------------------------------------------------
# Supabase — copy this file to .env.local and fill in the values.
# Find them in your Supabase project under Settings → API.
# ---------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / publishable key. Safe to expose to the browser: access is
# governed by the RLS policies in supabase/migrations/0001_init.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
